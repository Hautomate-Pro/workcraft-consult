{
    "name": "@workcraft/server",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed-admin": "tsx src/db/seed-admin.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.2.1",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.45.4",
        "express": "^4.21.1",
        "express-rate-limit": "^8.7.5",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.9.0",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
